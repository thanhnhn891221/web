  id               String   @id @default(cuid())
  name             String
  type             String   @default("points_multiplier")
  triggerCondition String?
  rewardType       String   @default("points")
  rewardValue      Float    @default(0)
  startDate        DateTime?
  endDate          DateTime?
  targetTierIds    String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  @@map("loyalty_campaigns")
}

// Phase 2: Customer Feedbacks
model CustomerFeedback {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String   @default("feedback")
  channel     String?  @default("app")
  subject     String
  content     String?
  rating      Int?
  refType     String?
  refId       String?
  status      String   @default("open")
  assignedTo  String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([customerId])
  @@index([status])
  @@map("customer_feedbacks")
}

// Phase 2: Online Orders
model OnlineOrder {
  id              String   @id @default(cuid())
  code            String   @unique
  platform        String   @default("website")
  platformOrderId String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String?
  shippingAddress String?
  items           Json?
