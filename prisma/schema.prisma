  maxDiscount    Float?
  expiresAt      DateTime?
  usageLimit     Int?     @default(1)
  usedCount      Int      @default(0)
  assignedTo     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("vouchers")
}

// Phase 3: Affiliate Commissions
