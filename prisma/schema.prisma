  discount        Float    @default(0)
  shippingFee     Float    @default(0)
  total           Float    @default(0)
  paymentMethod   String?  @default("cod")
  paymentStatus   String?  @default("unpaid")
  status          String   @default("pending")
  syncedAt        DateTime?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([platform])
  @@index([status])
  @@map("online_orders")
}

// Phase 2: Sales Assignments
model SalesAssignment {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  region       String?
  assignedDate DateTime @default(now()) @db.Date
  quota        Float?   @default(0)
  achieved     Float?   @default(0)
  status       String   @default("active")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId])
  @@map("sales_assignments")
}

// Phase 2: Call Logs
model CallLog {
  id            String   @id @default(cuid())
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  customerPhone String
  customerName  String?
  direction     String   @default("outbound")
  duration      Int?     @default(0)
  status        String   @default("completed")
  callType      String?  @default("ip")
  recordingUrl  String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([employeeId])
  @@map("call_logs")
}

// Phase 2: POS Sessions
model POSSession {
  id               String   @id @default(cuid())
  code             String   @unique
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  storeId          String?
  openedAt         DateTime @default(now())
  closedAt         DateTime?
  openingBalance   Float    @default(0)
  closingBalance   Float?
  totalSales       Float    @default(0)
  totalTransactions Int     @default(0)
  status           String   @default("open")
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions     POSTransaction[]

  @@map("pos_sessions")
}

// Phase 2: POS Transactions
model POSTransaction {
  id            String   @id @default(cuid())
  code          String   @unique
  sessionId     String
  session       POSSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId    String?
  customerName  String?
  items         Json?
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  tax           Float    @default(0)
  total         Float    @default(0)
  paymentMethod String   @default("cash")
  amountPaid    Float    @default(0)
  change        Float    @default(0)
  status        String   @default("completed")
  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@map("pos_transactions")
}

// Phase 2: Appointments
model Appointment {
  id            String   @id @default(cuid())
  code          String   @unique
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  storeId       String?
  scheduledAt   DateTime
  duration      Int?     @default(60)
  service       String?
  status        String   @default("scheduled")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([scheduledAt])
  @@map("appointments")
}

// Phase 2: Deposits
model Deposit {
  id           String   @id @default(cuid())
  code         String   @unique
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  amount       Float
  method       String?  @default("transfer")
  status       String   @default("active")
  appliedAt    DateTime?
  refundedAt   DateTime?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@map("deposits")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FMS — Factory Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model ProductionLine {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  status      String   @default("idle") // running, idle, maintenance, changeover
  product     String?
  capacity    Int      @default(1000)
  manager     String?
  efficiency  Float    @default(0)
  target      Int      @default(0)
  output      Int      @default(0)
  shift       String?
  operator    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  orders              ProductionOrder[]
  productionCommands  ProductionCommand[]

  @@map("production_lines")
}

model ProductionOrder {
  id           String   @id @default(cuid())
  code         String   @unique
  productId    String?
  productName  String
  quantity     Int
  completed    Int      @default(0)
  unit         String?
  lineId       String?
  line         ProductionLine? @relation(fields: [lineId], references: [id])
  priority     String   @default("medium")
  status       String   @default("queued")
  deadline     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  productionCommands ProductionCommand[]

  @@index([lineId])
  @@index([status])
  @@map("production_orders")
}

// Phase 5: BOM — Bill of Materials
model BillOfMaterial {
  id             String   @id @default(cuid())
  code           String   @unique
  productName    String
  productSku     String?
  version        String?  @default("1.0")
  outputQuantity Float    @default(1)
  outputUnit     String   @default("pcs")
  estimatedTime  Float?
  estimatedCost  Float?   @default(0)
  isActive       Boolean  @default(true)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  items              BOMItem[]
  productionCommands ProductionCommand[]

  @@map("bill_of_materials")
}

model BOMItem {
  id            String   @id @default(cuid())
  bomId         String
  bom           BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materialName  String
  materialSku   String?
  quantity      Float    @default(1)
  unit          String
  unitCost      Float?   @default(0)
  totalCost     Float?   @default(0)
  wastagePercent Float?  @default(0)
  isOptional    Boolean? @default(false)
  note          String?
  sortOrder     Int      @default(0)

  @@index([bomId])
  @@map("bom_items")
}

// Phase 5: Production Commands
model ProductionCommand {
  id                String   @id @default(cuid())
  code              String   @unique
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  bomId             String?
  bom               BillOfMaterial? @relation(fields: [bomId], references: [id], onDelete: SetNull)
  productName       String
  quantity          Float
  completedQty      Float    @default(0)
  unit              String?  @default("pcs")
  lineId            String?
  line              ProductionLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  status            String   @default("planned")
  priority          String?  @default("medium")
  assignedTo        String?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([status])
  @@map("production_commands")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// AMS, BMS & CMS — Finance & Controlling
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Transaction {
  id          String   @id @default(cuid())
  code        String   @unique
  date        DateTime @default(now())
  description String
  account     String
  debit       Float    @default(0)
  credit      Float    @default(0)
  type        String   @default("revenue")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("transactions")
}

model Invoice {
  id           String   @id @default(cuid())
  code         String   @unique
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  customerName String
  amount       Float
  dueDate      DateTime
  status       String   @default("unpaid")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  eInvoices    EInvoice[]

  @@index([salesOrderId])
  @@index([customerId])
  @@map("invoices")
}

model Budget {
  id           String   @id @default(cuid())
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentName String
  period       String
  allocated    Float
  spent        Float    @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([departmentId])
  @@map("budgets")
}

// Phase 4: Accounting Entries
model AccountingEntry {
  id            String   @id @default(cuid())
  code          String   @unique
  date          DateTime @default(now()) @db.Date
  type          String   @default("general")
  accountDebit  String
  accountCredit String
  amount        Float    @default(0)
  description   String
  refType       String?
  refId         String?
  refCode       String?
  currency      String?  @default("VND")
  exchangeRate  Float?   @default(1)
  status        String   @default("draft")
  postedBy      String?
  postedAt      DateTime?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  cashFlows     CashFlow[]

  @@index([type])
  @@index([date])
  @@index([status])
  @@map("accounting_entries")
}

// Phase 4: Cash Flows
model CashFlow {
  id                String   @id @default(cuid())
  code              String   @unique
  type              String   // receipt, payment
  category          String?
  amount            Float    @default(0)
  paymentMethod     String?  @default("cash")
  bankAccount       String?
  counterpartyName  String?
  counterpartyId    String?
  description       String
  date              DateTime @default(now()) @db.Date
  accountingEntryId String?
  accountingEntry   AccountingEntry? @relation(fields: [accountingEntryId], references: [id], onDelete: SetNull)
  status            String   @default("pending")
  approvedBy        String?
  approvedAt        DateTime?
  note              String?
  attachmentUrl     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([type])
  @@index([date])
  @@map("cash_flows")
}

// Phase 4: Cost Allocations
model CostAllocation {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  type            String   @default("prepaid")
  totalAmount     Float    @default(0)
  allocatedAmount Float    @default(0)
  remainingAmount Float    @default(0)
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  periods         Int      @default(12)
  amountPerPeriod Float    @default(0)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  accountDebit    String?
  accountCredit   String?
  status          String   @default("active")
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@map("cost_allocations")
}

// Phase 4: Depreciations
model Depreciation {
  id                      String   @id @default(cuid())
  assetId                 String?
  assetName               String
  assetCode               String?
  category                String?  @default("equipment")
  originalCost            Float    @default(0)
  residualValue           Float    @default(0)
  usefulLife              Int      @default(60)
  method                  String   @default("straight_line")
  monthlyDepreciation     Float    @default(0)
  accumulatedDepreciation Float    @default(0)
  bookValue               Float    @default(0)
  startDate               DateTime @db.Date
  endDate                 DateTime? @db.Date
  departmentId            String?
  department              Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  accountDebit            String?
  accountCredit           String?
  status                  String   @default("active")
  note                    String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deletedAt               DateTime?

  @@index([status])
  @@map("depreciations")
}

// Phase 4: E-Invoices
model EInvoice {
  id              String   @id @default(cuid())
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider        String   @default("viettel")
  invoiceNumber   String?
  invoiceSeries   String?
  issueDate       DateTime @default(now()) @db.Date
  buyerName       String
  buyerTaxCode    String?
  buyerAddress    String?
  buyerEmail      String?
  items           Json?
  subtotal        Float    @default(0)
  vatAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  currency        String?  @default("VND")
  status          String   @default("draft")
  signedAt        DateTime?
  sentAt          DateTime?
  pdfUrl          String?
  xmlData         String?
  errorLog        String?
  externalId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([provider])
  @@index([status])
  @@map("e_invoices")
}

// Phase 4: Journal Entries
model JournalEntry {
  id          String   @id @default(cuid())
  code        String   @unique
  date        DateTime @default(now()) @db.Date
  description String
  type        String   @default("general")
  totalDebit  Float    @default(0)
  totalCredit Float    @default(0)
  status      String   @default("draft")
  postedBy    String?
  postedAt    DateTime?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  lines       JournalEntryLine[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode    String
  accountName    String?
  debit          Float    @default(0)
  credit         Float    @default(0)
  description    String?

  @@index([journalEntryId])
  @@map("journal_entry_lines")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RMS — Research & Development
