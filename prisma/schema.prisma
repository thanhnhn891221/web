// AIO.MS — Database Schema
// PostgreSQL via Supabase + Prisma ORM
// RBAC: Many-to-many User ↔ Role, Role ↔ Module permissions
// ═══════════════════════════════════════════════════════════
// Schema version: 2.0 — All 5 Phases included
// ═══════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CORE & AUTH
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String   // bcrypt hash
  name        String
  avatar      String?
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Many-to-many: 1 user can have multiple roles
  userRoles   UserRole[]
  employee    Employee?
  auditLogs   AuditLog[]

  // Phase 5: Chat
  chatRoomMembers ChatRoomMember[]
  chatMessages    ChatMessage[]
  taskComments    TaskComment[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique   // super_admin, admin, operations_exec, finance_viewer...
  name        String              // Quản trị tối cao, Vận hành - Thực thi...
  description String?
  groupCode   String?             // foundation, operations, market, finance (null = system role)
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  userRoles   UserRole[]
  permissions RoleModulePermission[]

  @@map("roles")
}

// Join table: User ↔ Role (many-to-many)
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Module {
  id        String   @id @default(cuid())
  code      String   @unique   // CORE, IMS, HMS, PMS, WMS, TMS, FMS, QMS, RMS, MMS, SMS, OMS, DMS, AMS, CMS, BMS
  name      String              // Admin & Core, IT Management...
  nameVi    String              // Quản trị Hệ thống, Quản lý CNTT...
  groupCode String              // foundation, operations, market, finance
  icon      String              // Lucide icon name
  color     String              // HSL color string
  href      String              // /dashboard, /dashboard/ims...
  isEnabled Boolean  @default(true)
  orderIndex Int

  permissions RoleModulePermission[]

  @@map("modules")
}

// Role ↔ Module permissions (RBAC matrix)
model RoleModulePermission {
  id        String  @id @default(cuid())
  roleId    String
  moduleId  String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canManage Boolean @default(false)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@map("role_module_permissions")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general") // general, security, mail, system
  type      String   @default("string") // string, number, boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("system_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // create, update, delete, login, logout, access_denied
  module    String   // CORE, HMS, PMS...
  target    String   // "Employee NV-001", "Order OMS-1254"
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HMS — Human Resource Management
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Department {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique // BGD, IT, HR, SALE, SX, KT
  parentId    String?
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
  managerId   String?
  description String?
  level       Int          @default(0)
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  employees       Employee[]
  budgets         Budget[]
  tasks           Task[]
  costAllocations CostAllocation[]
  depreciations   Depreciation[]

  @@map("departments")
}

model Employee {
  id             String   @id @default(cuid())
  employeeCode   String   @unique  // NV-001, NV-002
  fullName       String
  email          String   @unique
  phone          String?
  avatar         String?
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  position       String
  level          String?  // intern, junior, mid, senior, lead, manager, director
  hireDate       DateTime
  status         String   @default("active") // active, probation, on_leave, resigned
  salary         Float?
  sysRole        String?  // Ghi chú vai trò hệ thống: Admin, Manager, User...
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  // Phase 1 expanded fields
  dateOfBirth    DateTime?
  gender         String?  @default("other")
  idNumber       String?
  address        String?
  bankAccount    String?
  bankName       String?
  taxCode        String?
  insuranceCode  String?
  contractType   String?  @default("permanent")
  contractEndDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  // Phase 1 relations
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  payrollRecords   PayrollRecord[]
  careerPaths      CareerPath[]
  achievements     Achievement[]
  // Phase 2 relations
  salesAssignments SalesAssignment[]
  callLogs         CallLog[]
  posSessions      POSSession[]
  appointments     Appointment[]
  // Phase 5 relations
  tasksAssigned    Task[]  @relation("TaskAssignee")
  tasksReported    Task[]  @relation("TaskReporter")

  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

// Phase 1: Ca làm (Work Shifts)
model WorkShift {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  startTime     String   // "08:00"
  endTime       String   // "17:00"
  breakMinutes  Int      @default(60)
  workingHours  Float    @default(8)
  color         String?  @default("#3B82F6")
  isOvernight   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  attendances   Attendance[]

  @@map("work_shifts")
}

// Phase 1: Chấm công (Attendances)
model Attendance {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId         String?
  shift           WorkShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  date            DateTime @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  checkInMethod   String?  @default("manual") // manual, fingerprint, face, gps
  checkInLocation String?
  workingHours    Float?   @default(0)
  overtimeHours   Float?   @default(0)
  status          String   @default("present") // present, absent, late, early_leave, on_leave, holiday
  note            String?
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendances")
}

// Phase 1: Nghỉ phép (Leave Requests)
model LeaveRequest {
  id           String   @id @default(cuid())
  code         String   @unique
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String   @default("annual") // annual, sick, maternity, unpaid, compassionate, other
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  totalDays    Float    @default(1)
  reason       String?
  status       String   @default("pending") // pending, approved, rejected, cancelled
  approvedBy   String?
  approvedAt   DateTime?
  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

// Phase 1: Số ngày phép (Leave Balances)
model LeaveBalance {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year          Int
  type          String   @default("annual")
  totalDays     Float    @default(12)
  usedDays      Float    @default(0)
  remainingDays Float    @default(12)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, year, type])
  @@map("leave_balances")
}

// Phase 1: Lương thưởng (Payroll Records)
model PayrollRecord {
  id              String   @id @default(cuid())
  code            String   @unique
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period          String   // "2026-04"
  baseSalary      Float    @default(0)
  allowances      Float    @default(0)
  overtime        Float    @default(0)
  bonus           Float    @default(0)
  deductions      Float    @default(0)
  socialInsurance Float    @default(0)
  healthInsurance Float    @default(0)
  personalTax     Float    @default(0)
  netSalary       Float    @default(0)
  workingDays     Float    @default(0)
  paidLeave       Float    @default(0)
  unpaidLeave     Float    @default(0)
  status          String   @default("draft") // draft, calculated, approved, paid
  paidAt          DateTime?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([employeeId, period])
  @@index([employeeId])
  @@index([period])
  @@index([status])
  @@map("payroll_records")
}

// Phase 1: Lộ trình thăng tiến (Career Paths)
model CareerPath {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  currentPosition String
  currentLevel    String?
  targetPosition  String
  targetLevel     String?
  targetDate      DateTime?
  requirements    String?
  progress        Int      @default(0) // 0-100%
  status          String   @default("active") // active, completed, paused
  mentorId        String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([employeeId])
  @@map("career_paths")
}

// Phase 1: Thành tích (Achievements / KPI)
model Achievement {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title         String
  type          String   @default("kpi") // kpi, award, certificate, disciplinary
  category      String?
  period        String?
  targetValue   Float?
  actualValue   Float?
  score         Float?
  rating        String?
  awardAmount   Float?   @default(0)
  description   String?
  evidenceUrl   String?
  evaluatedBy   String?
  evaluatedAt   DateTime?
  status        String   @default("pending") // pending, approved, rejected
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([employeeId])
  @@index([type])
  @@map("achievements")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PMS — Purchase Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contact     String?
  email       String?
  phone       String?
  category    String?  // Nguyên vật liệu, Bao bì, Máy móc...
  rating      Float?   @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  code        String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  totalAmount Float    @default(0)
  status      String   @default("draft") // draft, pending, approved, ordered, received, cancelled
  expectedDate DateTime?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  items       PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemName        String
  quantity        Float
  unit            String
  unitPrice       Float
  totalPrice      Float

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// WMS — Warehouse Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Warehouse {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  address        String?
  capacity       Float    @default(0)
  usedCapacity   Float    @default(0)
  managerId      String?
  status         String   @default("active") // active, maintenance
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  inventoryItems     InventoryItem[]
  stockMovementsFrom StockMovement[] @relation("MovementFrom")
  stockMovementsTo   StockMovement[] @relation("MovementTo")
  stockAlerts        StockAlert[]

  @@map("warehouses")
}

model InventoryItem {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  category     String?
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  zone         String?
  quantity     Float    @default(0)
  minStock     Float    @default(0)
  unit         String
  status       String   @default("in_stock") // in_stock, low_stock, out_of_stock
  lastUpdated  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  stockAlerts  StockAlert[]

  @@index([warehouseId])
  @@index([sku])
  @@map("inventory_items")
}

model StockMovement {
  id             String   @id @default(cuid())
  type           String   // in, out, transfer
  itemName       String
  sku            String?  
  quantity       Float
  unit           String
  fromWarehouseId String?
  fromWarehouse  Warehouse? @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse    Warehouse? @relation("MovementTo", fields: [toWarehouseId], references: [id])
  reason         String?
  refCode        String?  // PO-2026-001, OMS-1254...
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([type])
  @@map("stock_movements")
}

// Phase 2: Cảnh báo tồn kho
model StockAlert {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemName    String
  sku         String?
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  currentQty  Float    @default(0)
  minQty      Float    @default(0)
  alertType   String   @default("low_stock") // low_stock, out_of_stock, overstock
  severity    String   @default("warning") // info, warning, critical
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([alertType])
  @@index([isResolved])
  @@map("stock_alerts")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OMS, SMS & TMS — Market & Operations
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  email          String?
  type           String   @default("B2B") // B2B, B2C
  tier           String?  @default("standard")
  rating         Float?   @default(0)
  // Phase 2 expanded
  code           String?
  address        String?
  taxCode        String?
  source         String?  @default("direct")
  groupId        String?
  loyaltyTierId  String?
  loyaltyPoints  Int      @default(0)
  totalSpent     Float    @default(0)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  salesOrders      SalesOrder[]
  invoices         Invoice[]
  loyaltyPointsTx  LoyaltyPoint[]
  customerFeedbacks CustomerFeedback[]
  onlineOrders     OnlineOrder[]
  salesAssignments SalesAssignment[]
  deposits         Deposit[]
  appointments     Appointment[]
  warrantyTickets  WarrantyTicket[]

  @@map("customers")
}

model SalesOrder {
  id              String   @id @default(cuid())
  code            String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  totalAmount     Float    @default(0)
  status          String   @default("pending") // pending, confirmed, processing, shipped, delivered, cancelled
  channel         String?
  expectedDelivery DateTime?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  items           SalesOrderItem[]
  shipments       Shipment[]
  invoices        Invoice[]
  deposits        Deposit[]

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  itemName     String
  quantity     Float
  unit         String
  unitPrice    Float
  totalPrice   Float

  @@index([salesOrderId])
  @@map("sales_order_items")
}

model Lead {
  id        String   @id @default(cuid())
  code      String?  @unique
  name      String
  company   String?
  phone     String?
  email     String?
  source    String?  @default("Website")
  status    String   @default("new") // new, contacted, qualified, proposal, won, lost
  value     Float    @default(0)
  priority  String   @default("medium") // high, medium, low
  potential String?  @default("medium") // low, medium, high
  note      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@map("leads")
}

model Driver {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  vehicle         String?
  licensePlate    String?
  activeShipments Int      @default(0)
  completedToday  Int      @default(0)
  status          String   @default("available") // available, on_route, off_duty
  rating          Float?   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  shipments       Shipment[]

  @@map("drivers")
}

model Shipment {
  id              String   @id @default(cuid())
  code            String   @unique
  salesOrderId    String?
  salesOrder      SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customerName    String
  address         String
  driverId        String?
  driver          Driver?  @relation(fields: [driverId], references: [id])
  itemsCount      Int      @default(1)
  weight          String?
  status          String   @default("pending") // pending, picked_up, in_transit, delivered, failed
  currentLocation String?
  estimatedDelivery DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([salesOrderId])
  @@index([driverId])
  @@index([status])
  @@map("shipments")
}

// Phase 2: Customer Groups
model CustomerGroup {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  discountPercent Float?   @default(0)
  color           String?  @default("#3B82F6")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@map("customer_groups")
}

// Phase 2: Loyalty Tiers
model LoyaltyTier {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  minPoints       Int      @default(0)
  maxPoints       Int?
  discountPercent Float?   @default(0)
  pointMultiplier Float?   @default(1)
  benefits        String?
  color           String?  @default("#CD7F32")
  icon            String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("loyalty_tiers")
}

// Phase 2: Loyalty Points
model LoyaltyPoint {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String   @default("earn") // earn, spend, adjust, expire
  points      Int
  balance     Int      @default(0)
  description String?
  refType     String?
  refId       String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@map("loyalty_points")
}

// Phase 2: Loyalty Campaigns
