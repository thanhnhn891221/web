// AIO.MS — Database Schema
// PostgreSQL via Supabase + Prisma ORM
// RBAC: Many-to-many User ↔ Role, Role ↔ Module permissions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CORE & AUTH
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String   // bcrypt hash
  name        String
  avatar      String?
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Many-to-many: 1 user can have multiple roles
  userRoles   UserRole[]
  employee    Employee?
  auditLogs   AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique   // super_admin, admin, operations_exec, finance_viewer...
  name        String              // Quản trị tối cao, Vận hành - Thực thi...
  description String?
  groupCode   String?             // foundation, operations, market, finance (null = system role)
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  userRoles   UserRole[]
  permissions RoleModulePermission[]

  @@map("roles")
}

// Join table: User ↔ Role (many-to-many)
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Module {
  id        String   @id @default(cuid())
  code      String   @unique   // CORE, IMS, HMS, PMS, WMS, TMS, FMS, QMS, RMS, MMS, SMS, OMS, DMS, AMS, CMS, BMS
  name      String              // Admin & Core, IT Management...
  nameVi    String              // Quản trị Hệ thống, Quản lý CNTT...
  groupCode String              // foundation, operations, market, finance
  icon      String              // Lucide icon name
  color     String              // HSL color string
  href      String              // /dashboard, /dashboard/ims...
  isEnabled Boolean  @default(true)
  orderIndex Int

  permissions RoleModulePermission[]

  @@map("modules")
}

// Role ↔ Module permissions (RBAC matrix)
model RoleModulePermission {
  id        String  @id @default(cuid())
  roleId    String
  moduleId  String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@map("role_module_permissions")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general") // general, security, mail, system
  type      String   @default("string") // string, number, boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("system_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // create, update, delete, login, logout, access_denied
  module    String   // CORE, HMS, PMS...
  target    String   // "Employee NV-001", "Order OMS-1254"
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HMS — Human Resource Management
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Department {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique // BGD, IT, HR, SALE, SX, KT
  parentId    String?
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
  managerId   String?
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  employees   Employee[]
  budgets     Budget[]

  @@map("departments")
}

model Employee {
  id           String   @id @default(cuid())
  employeeCode String   @unique  // NV-001, NV-002
  fullName     String
  email        String   @unique
  phone        String?
  avatar       String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  position     String
  level        String?  // intern, junior, mid, senior, lead, manager, director
  hireDate     DateTime
  status       String   @default("active") // active, probation, on_leave, resigned
  salary       Float?
  sysRole      String?  // Ghi chú vai trò hệ thống: Admin, Manager, User...
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PMS — Purchase Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contact     String?
  email       String?
  phone       String?
  category    String?  // Nguyên vật liệu, Bao bì, Máy móc...
  rating      Float?   @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  code        String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  totalAmount Float    @default(0)
  status      String   @default("draft") // draft, pending, approved, ordered, received, cancelled
  expectedDate DateTime?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  items       PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemName        String
  quantity        Float
  unit            String
  unitPrice       Float
  totalPrice      Float

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// WMS — Warehouse Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Warehouse {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  address        String?
  capacity       Float    @default(0)
  usedCapacity   Float    @default(0)
  managerId      String?
  status         String   @default("active") // active, maintenance
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  inventoryItems InventoryItem[]
  stockMovementsFrom StockMovement[] @relation("MovementFrom")
  stockMovementsTo   StockMovement[] @relation("MovementTo")

  @@map("warehouses")
}

model InventoryItem {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  category     String?
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  zone         String?
  quantity     Float    @default(0)
  minStock     Float    @default(0)
  unit         String
  status       String   @default("in_stock") // in_stock, low_stock, out_of_stock
  lastUpdated  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([warehouseId])
  @@index([sku])
  @@map("inventory_items")
}

model StockMovement {
  id             String   @id @default(cuid())
  type           String   // in, out, transfer
  itemName       String
  sku            String?  
  quantity       Float
  unit           String
  fromWarehouseId String?
  fromWarehouse  Warehouse? @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse    Warehouse? @relation("MovementTo", fields: [toWarehouseId], references: [id])
  reason         String?
  refCode        String?  // PO-2026-001, OMS-1254...
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([type])
  @@map("stock_movements")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OMS, SMS & TMS — Market & Operations Expansion
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  type      String   @default("B2B") // B2B, B2C
  tier      String?  @default("standard")
  rating    Float?   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@map("customers")
}

model SalesOrder {
  id              String   @id @default(cuid())
  code            String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  totalAmount     Float    @default(0)
  status          String   @default("pending") // pending, confirmed, processing, shipped, delivered, cancelled
  channel         String?
  expectedDelivery DateTime?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  items           SalesOrderItem[]
  shipments       Shipment[]
  invoices        Invoice[]

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  itemName     String
  quantity     Float
  unit         String
  unitPrice    Float
  totalPrice   Float

  @@index([salesOrderId])
  @@map("sales_order_items")
}

model Lead {
  id        String   @id @default(cuid())
  code      String?  @unique
  name      String
  company   String?
  phone     String?
  email     String?
  source    String?  @default("Website")
  status    String   @default("new") // new, contacted, qualified, proposal, won, lost
  value     Float    @default(0)
  priority  String   @default("medium") // high, medium, low
  potential String?  @default("medium") // low, medium, high
  note      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@map("leads")
}

model Driver {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  vehicle         String?
  licensePlate    String?
  activeShipments Int      @default(0)
  completedToday  Int      @default(0)
  status          String   @default("available") // available, on_route, off_duty
  rating          Float?   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  shipments       Shipment[]

  @@map("drivers")
}

model Shipment {
  id              String   @id @default(cuid())
  code            String   @unique
  salesOrderId    String?
  salesOrder      SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customerName    String
  address         String
  driverId        String?
  driver          Driver?  @relation(fields: [driverId], references: [id])
  itemsCount      Int      @default(1)
  weight          String?
  status          String   @default("pending") // pending, picked_up, in_transit, delivered, failed
  currentLocation String?
  estimatedDelivery DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([salesOrderId])
  @@index([driverId])
  @@index([status])
  @@map("shipments")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FMS — Factory Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model ProductionLine {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  status      String   @default("idle") // running, idle, maintenance, changeover
  product     String?
  capacity    Int      @default(1000)
  manager     String?
  efficiency  Float    @default(0)
  target      Int      @default(0)
  output      Int      @default(0)
  shift       String?
  operator    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  orders      ProductionOrder[]

  @@map("production_lines")
}

model ProductionOrder {
  id           String   @id @default(cuid())
  code         String   @unique
  productId    String?
  productName  String
  quantity     Int
  completed    Int      @default(0)
  unit         String?
  lineId       String?
  line         ProductionLine? @relation(fields: [lineId], references: [id])
  priority     String   @default("medium") // high, medium, low
  status       String   @default("queued") // queued, in_progress, completed, on_hold
  deadline     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([lineId])
  @@index([status])
  @@map("production_orders")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// AMS, BMS & CMS — Finance & Controling Group
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Transaction {
  id          String   @id @default(cuid())
  code        String   @unique
  date        DateTime @default(now())
  description String
  account     String
  debit       Float    @default(0)
  credit      Float    @default(0)
  type        String   @default("revenue") // revenue, expense, receivable, payable, depreciation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("transactions")
}

model Invoice {
  id           String   @id @default(cuid())
  code         String   @unique
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  customerName String
  amount       Float
  dueDate      DateTime
  status       String   @default("unpaid") // paid, unpaid, overdue
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([salesOrderId])
  @@index([customerId])
  @@map("invoices")
}

model Budget {
  id           String   @id @default(cuid())
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentName String
  period       String   // e.g. "Q2/2026", "2026"
  allocated    Float
  spent        Float    @default(0)
  status       String   @default("active") // active, closed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([departmentId])
  @@map("budgets")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RMS — Research & Development
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model ResearchProject {
  id        String   @id @default(cuid())
  code      String   @unique // RD-001
  name      String
  phase     String   @default("concept") // concept, research, prototype, testing, completed
  lead      String
  teamSize  Int      @default(1)
  progress  Int      @default(0)
  deadline  DateTime?
  budget    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("research_projects")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MMS — Marketing Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model MarketingCampaign {
  id          String   @id @default(cuid())
  name        String
  channel     String
  budget      Float    @default(0)
  spent       Float    @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  status      String   @default("planned") // planned, active, completed
  period      String?  // e.g. "01/01 - 15/02/2026"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("marketing_campaigns")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// QMS — Quality Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model QualityCheck {
  id          String   @id @default(cuid())
  code        String   @unique // QC-001
  product     String
  batch       String
  type        String   @default("incoming") // incoming, in_process, final, customer_return
  inspector   String
  result      String   @default("pending") // passed, failed, pending, conditional
  defectRate  Float    @default(0)
  checkedAt   DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  criteria    QualityCriteria[]

  @@map("quality_checks")
}

model QualityCriteria {
  id             String       @id @default(cuid())
  qualityCheckId String
  qualityCheck   QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)
  name           String
  standard       String
  actual         String
  pass           Boolean      @default(true)

  @@index([qualityCheckId])
  @@map("quality_criteria")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// IMS — Information Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model ITAsset {
  id          String   @id @default(cuid())
  code        String   @unique // AST-001
  name        String
  type        String   // server, workstation, network, software
  status      String   @default("active") // active, maintenance, retired
  location    String?
  assignedTo  String?  // Employee ID or name
  purchaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("it_assets")
}

model SupportTicket {
  id          String   @id @default(cuid())
  code        String   @unique // TKT-001
  title       String
  description String?
  priority    String   @default("medium") // low, medium, high, critical
  status      String   @default("open") // open, in_progress, resolved, closed
  requester   String
  assignee    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("support_tickets")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DMS — Distribution Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Distributor {
  id        String   @id @default(cuid())
  code      String   @unique // DL-001
  name      String
  region    String
  type      String   @default("Cấp 1")
  contact   String
  phone     String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("distributors")
}

model DistributionRoute {
  id        String   @id @default(cuid())
  code      String   @unique // RT-001
  name      String
  driverId  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("distribution_routes")
}

model Risk {
  id          String   @id @default(cuid())
  code        String   @unique // RSK-001
  title       String
  description String?
  category    String   @default("operational") // operational, financial, strategic, compliance
  impact      String   @default("medium") // low, medium, high, extreme
  likelihood  String   @default("medium") // low, medium, high
  status      String   @default("identified") // identified, monitoring, mitigated, occurred
  owner       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("risks")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GMS — Gateway Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model GatewayIntegration {
  id          String   @id @default(cuid())
  provider    String   // name of provider (e.g. MISA, SAP, ZALO)
  category    String   // e-invoice, erp, timekeeping, message...
  name        String   // Display name: 'MISA meInvoice', 'SAP S/4HANA'
  apiKey      String?
  endpoint    String?
  webhookUrl  String?
  status      String   @default("inactive") // active, inactive, error
  lastSyncAt  DateTime?
  errorLog    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([provider])
  @@index([category])
  @@index([status])
  @@map("gateway_integrations")
}
