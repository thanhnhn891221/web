  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@map("message_campaigns")
}

// Phase 3: Promotions
model Promotion {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  type               String   @default("percent")
  value              Float    @default(0)
  minOrderAmount     Float?   @default(0)
  maxDiscount        Float?
  applicableProducts String?
