  address           String?
  latitude          Float?
  longitude         Float?
  visitOrder        Int      @default(0)
  lastVisitedAt     DateTime?
  visitNote         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("route_maps")
}

// Phase 3: Dealer Policies
model DealerPolicy {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  type            String   @default("discount")
  tierLevel       String?
  discountPercent Float?   @default(0)
  targetAmount    Float?   @default(0)
  bonusPercent    Float?   @default(0)
  conditions      String?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  dealerOrders    DealerOrder[]

  @@map("dealer_policies")
}

// Phase 3: Dealer Orders
model DealerOrder {
  id              String   @id @default(cuid())
  code            String   @unique
  distributorId   String
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  policyId        String?
  policy          DealerPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  items           Json?
  subtotal        Float    @default(0)
  discount        Float    @default(0)
  total           Float    @default(0)
  status          String   @default("pending")
  expectedDelivery DateTime?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([distributorId])
  @@map("dealer_orders")
}

// Phase 3: Web Stores
model WebStore {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  logo      String?
  theme     Json?
  isActive  Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("web_stores")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// QMS — Quality Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model QualityCheck {
  id          String   @id @default(cuid())
  code        String   @unique
  product     String
  batch       String
  type        String   @default("incoming")
  inspector   String
  result      String   @default("pending")
  defectRate  Float    @default(0)
  checkedAt   DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  criteria    QualityCriteria[]

  @@map("quality_checks")
}

model QualityCriteria {
  id             String       @id @default(cuid())
  qualityCheckId String
  qualityCheck   QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)
  name           String
  standard       String
  actual         String
  pass           Boolean      @default(true)

  @@index([qualityCheckId])
  @@map("quality_criteria")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// IMS — Information Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model ITAsset {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String
  status      String   @default("active")
  location    String?
  assignedTo  String?
  purchaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("it_assets")
}

model SupportTicket {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String?
  priority    String   @default("medium")
  status      String   @default("open")
  requester   String
  assignee    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("support_tickets")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DMS — Distribution Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Distributor {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  region    String
  type      String   @default("Cấp 1")
  contact   String
  phone     String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  dealerOrders DealerOrder[]

  @@map("distributors")
}

model DistributionRoute {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  driverId  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("distribution_routes")
}

model Risk {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String?
  category    String   @default("operational")
  impact      String   @default("medium")
  likelihood  String   @default("medium")
  status      String   @default("identified")
  owner       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("risks")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GMS — Gateway Management System
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model GatewayIntegration {
  id          String   @id @default(cuid())
  provider    String
  category    String
  name        String
  apiKey      String?
  endpoint    String?
  webhookUrl  String?
  status      String   @default("inactive")
  lastSyncAt  DateTime?
  errorLog    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([provider])
  @@index([category])
  @@index([status])
  @@map("gateway_integrations")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PHASE 5: Workflow, Tasks, Chat, Warranty
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Tasks
model Task {
  id            String   @id @default(cuid())
  code          String   @unique
  title         String
  description   String?
  projectId     String?
  assigneeId    String?
  assignee      Employee? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId    String?
  reporter      Employee? @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  priority      String   @default("medium")
  status        String   @default("todo")
  dueDate       DateTime?
  startDate     DateTime?
  completedAt   DateTime?
  estimatedHours Float?
  actualHours   Float?
  tags          String?
  parentTaskId  String?
  parentTask    Task?    @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks      Task[]   @relation("TaskHierarchy")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  comments      TaskComment[]

  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([taskId])
  @@map("task_comments")
}

// Workflows
model Workflow {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  module       String?
  triggerEvent String?
  isActive     Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  steps        WorkflowStep[]
  instances    WorkflowInstance[]

  @@map("workflows")
}

model WorkflowStep {
  id                 String   @id @default(cuid())
  workflowId         String
  workflow           Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder          Int      @default(1)
  name               String
  type               String   @default("approval")
  assigneeRole       String?
  assigneeId         String?
  action             String?
  conditionJson      Json?
  timeoutHours       Int?
  nextStepOnApprove  String?
  nextStepOnReject   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([workflowId])
  @@map("workflow_steps")
}

model WorkflowInstance {
  id            String   @id @default(cuid())
  workflowId    String
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  refType       String
  refId         String
  currentStepId String?
  status        String   @default("running")
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  data          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workflowId])
  @@index([refType, refId])
  @@map("workflow_instances")
}

// Chat
model ChatRoom {
  id          String   @id @default(cuid())
  name        String?
  type        String   @default("direct")
  description String?
  avatarUrl   String?
  isArchived  Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ChatRoomMember[]
  messages    ChatMessage[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         String   @id @default(cuid())
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("member")
  lastReadAt DateTime?
  joinedAt   DateTime @default(now())

  @@unique([roomId, userId])
  @@map("chat_room_members")
}

model ChatMessage {
  id            String   @id @default(cuid())
  roomId        String
  room          ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content       String?
  type          String   @default("text")
  attachmentUrl String?
  replyToId     String?
  isEdited      Boolean  @default(false)
  isPinned      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([roomId])
  @@index([createdAt])
  @@map("chat_messages")
}

// Warranty
model WarrantyPolicy {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  productCategory String?
  durationMonths  Int      @default(12)
  coverageType    String?  @default("full")
  conditions      String?
  exclusions      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  processes       WarrantyProcess[]
  tickets         WarrantyTicket[]

  @@map("warranty_policies")
}

model WarrantyProcess {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  policyId      String?
  policy        WarrantyPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  steps         Json?
  totalSlaHours Int?     @default(72)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tickets       WarrantyTicket[]

  @@map("warranty_processes")
}

model WarrantyTicket {
  id              String   @id @default(cuid())
  code            String   @unique
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String?
  productName     String
  productSerial   String?
  purchaseDate    DateTime? @db.Date
  policyId        String?
  policy          WarrantyPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  processId       String?
  process         WarrantyProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  currentStep     Int?     @default(1)
  issue           String
  diagnosis       String?
  solution        String?
  partsCost       Float?   @default(0)
  laborCost       Float?   @default(0)
  totalCost       Float?   @default(0)
  isUnderWarranty Boolean? @default(true)
  assignedTo      String?
  status          String   @default("received")
  receivedAt      DateTime? @default(now())
  completedAt     DateTime?
  returnedAt      DateTime?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([status])
  @@index([customerId])
  @@map("warranty_tickets")
}
